# Nginx configuration example for CultivAR FastAPI deployment (with dual-stack migration support)

# Upstream definitions for Flask and FastAPI services
upstream flask_backend {
    server localhost:5000; # Assuming Flask runs on port 5000
}

upstream fastapi_backend {
    server localhost:8000; # Assuming FastAPI runs on port 8000
}

# Dual-stack configuration (for migration testing)
# upstream flask_backend {
#     server localhost:5000;
# }
# upstream fastapi_backend {
#     server localhost:8000;
# }
# Use location blocks to route different paths to different backends

server {
    listen 80;
    listen 443 ssl;
    server_name your_domain.com; # Replace with your domain

    # SSL configuration (uncomment and configure for production)
    # ssl_certificate /etc/nginx/ssl/your_domain.com.crt;
    # ssl_certificate_key /etc/nginx/ssl/your_domain.com.key;
    # include /etc/nginx/options-ssl-nginx.conf; # Recommended SSL settings
    # ssl_dhparam /etc/nginx/ssl/dhparam.pem; # Diffie-Hellman parameter

    # Optional: Redirect HTTP to HTTPS
    # if ($scheme != "https") {
    #     return 301 https://$host$request_uri;
    # }

    # Health check endpoints
    location = /health/flask {
        proxy_pass http://flask_backend/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        allow 127.0.0.1; # Only allow local access to health check
        deny all;
    }

    location = /health/fastapi {
        proxy_pass http://fastapi_backend/health; # FastAPI's health endpoint
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        allow 127.0.0.1; # Only allow local access to health check
        deny all;
    }

    # Gradual traffic shift example (uncomment to enable)
    # This sends 10% of traffic to FastAPI, 90% to Flask
    # map $request_id $backend_target {
    #     "~^[0-9a-f]{1}[0-9a-f]{31}$" "fastapi_backend"; # 1/16th of traffic (approx 6.25%)
    #     default "flask_backend";
    # }
    #
    # location / {
    #     proxy_pass http://$backend_target;
    #     # ... common proxy headers ...
    # }

    # Percentage-based traffic splitting (uncomment to enable gradual migration)
    # This sends 20% of traffic to FastAPI, 80% to Flask
    # split_clients $request_id $backend_target {
    #     20% fastapi_backend;
    #     * flask_backend;
    # }

    # Default location: Route all traffic to FastAPI (primary)
    # This can be modified for path-based routing or gradual rollout
    location / {
        proxy_pass http://fastapi_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Optional: Increase buffer size for large responses
        # proxy_buffers 8 16k;
        # proxy_buffer_size 32k;
    }

    # Example: Route specific API versions or paths to FastAPI
    location /api/v2/ {
        proxy_pass http://fastapi_backend/api/v2/; # Ensure trailing slash if needed
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Route FastAPI docs to FastAPI
    location /docs {
        proxy_pass http://fastapi_backend/docs;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /redoc {
        proxy_pass http://fastapi_backend/redoc;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /openapi.json {
        proxy_pass http://fastapi_backend/openapi.json;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # WebSocket proxy for FastAPI (if applicable)
    location /ws/ {
        proxy_pass http://fastapi_backend/ws/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Error pages
    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }

    # Logging
    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log;
}

# Example for rate limiting (uncomment and adjust as needed)
# limit_req_zone $binary_remote_addr zone=mylimit:10m rate=5r/s;
#
# server {
#     # ...
#     location /api/ {
#         limit_req zone=mylimit burst=10 nodelay;
#         # ...
#     }
# }
