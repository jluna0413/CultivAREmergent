# Docker Environment Template
# Use this as a template for docker-compose environment variables

# Copy these to your docker-compose.yml environment section

# SECURITY KEYS (Generate unique keys for each deployment)
SECRET_KEY=${SECRET_KEY}
JWT_SECRET_KEY=${JWT_SECRET_KEY}
SESSION_SECRET_KEY=${SESSION_SECRET_KEY}
CSRF_SECRET_KEY=${CSRF_SECRET_KEY}
FLASH_SECRET_KEY=${FLASH_SECRET_KEY}

# APPLICATION CONFIGURATION
DEBUG=${DEBUG:-False}
APP_MODE=${APP_MODE:-fastapi}
CULTIVAR_PORT=${CULTIVAR_PORT:-5000}
FASTAPI_PORT=${FASTAPI_PORT:-8000}

# SSL/TLS CONFIGURATION
SSL_ENABLED=${SSL_ENABLED:-False}
SSL_CERT_PATH=${SSL_CERT_PATH}
SSL_KEY_PATH=${SSL_KEY_PATH}

# DATABASE CONFIGURATION
CULTIVAR_DB_DRIVER=${CULTIVAR_DB_DRIVER:-sqlite}
SQLITE_DB_PATH=${SQLITE_DB_PATH:-./data/cultivar.db}
# PostgreSQL settings (if using PostgreSQL)
# CULTIVAR_DB_HOST=${CULTIVAR_DB_HOST}
# CULTIVAR_DB_PORT=${CULTIVAR_DB_PORT:-5432}
# CULTIVAR_DB_USER=${CULTIVAR_DB_USER}
# CULTIVAR_DB_PASSWORD=${CULTIVAR_DB_PASSWORD}
# CULTIVAR_DB_NAME=${CULTIVAR_DB_NAME:-cultivardb}

# SENSOR CONFIGURATION
POLLING_INTERVAL=${POLLING_INTERVAL:-300}
STREAM_GRAB_INTERVAL=${STREAM_GRAB_INTERVAL:-3600}

# UPLOAD CONFIGURATION
UPLOAD_FOLDER=${UPLOAD_FOLDER:-./uploads}
MAX_CONTENT_LENGTH=${MAX_CONTENT_LENGTH:-16777216}

# FRONTEND CONFIGURATION
FRONTEND_ORIGINS=${FRONTEND_ORIGINS:-http://localhost:3000}

# JWT CONFIGURATION
JWT_ALGORITHM=${JWT_ALGORITHM:-HS256}
JWT_EXPIRATION_MINUTES=${JWT_EXPIRATION_MINUTES:-1440}

# GUEST MODE
GUEST_MODE=${GUEST_MODE:-False}
