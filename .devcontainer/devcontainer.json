{
  "name": "CultivAR FastAPI (Docker)",
  "dockerComposeFile": "../docker-compose.fastapi.yml",
  "service": "cultivar_fastapi",
  "workspaceFolder": "/app",
  "extensions": [
    "ms-python.python",
    "ms-python.vscode-pylance"
  ],
  "settings": {
    "python.defaultInterpreterPath": "/usr/local/bin/python"
  },
  "forwardPorts": [8000],
  "shutdownAction": "stopCompose"
}