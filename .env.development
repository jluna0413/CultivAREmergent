# CultivAR Development Environment Configuration
# Safe defaults for development and testing

# SECURITY KEYS (Use different keys for production!)
SECRET_KEY=dev-secret-key-not-for-production-use-only-development
JWT_SECRET_KEY=dev-jwt-key-not-for-production-use-only-development
SESSION_SECRET_KEY=dev-session-key-not-for-production-use-only-development
CSRF_SECRET_KEY=dev-csrf-key-not-for-production-use-only-development
FLASH_SECRET_KEY=dev-flash-key-not-for-production-use-only-development

# APPLICATION CONFIGURATION
DEBUG=True
APP_MODE=fastapi
CULTIVAR_PORT=5000
FASTAPI_PORT=8000

# SSL/TLS CONFIGURATION (Disabled for development)
SSL_ENABLED=False

# DATABASE CONFIGURATION
CULTIVAR_DB_DRIVER=sqlite
SQLITE_DB_PATH=./data/cultivar.db

# SENSOR CONFIGURATION
POLLING_INTERVAL=300
STREAM_GRAB_INTERVAL=3600

# UPLOAD CONFIGURATION
UPLOAD_FOLDER=./uploads
MAX_CONTENT_LENGTH=16777216

# FRONTEND CONFIGURATION
FRONTEND_ORIGINS=http://localhost:3000

# JWT CONFIGURATION
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# GUEST MODE (Enabled for easy testing)
GUEST_MODE=True

# CORS CONFIGURATION
CORS_ORIGINS=http://localhost:3000
