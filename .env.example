# CultivAR Environment Configuration
# Copy this file to .env and update with your actual values

# =====================================================
# APPLICATION ENVIRONMENT
# =====================================================
ENVIRONMENT=production
DEBUG=false
TESTING=false

# =====================================================
# DATABASE CONFIGURATION
# =====================================================
# PostgreSQL for production
DATABASE_URL=postgresql+asyncpg://cultivar_user:your_secure_password@localhost:5432/cultivar_db
DATABASE_SSL=true

# SQLite for development (local only)
# DATABASE_URL=sqlite+aiosqlite:///./cultivar.db

# =====================================================
# SECURITY CONFIGURATION
# =====================================================

# JWT Secret Key (CRITICAL: Generate a secure random key)
JWT_SECRET_KEY=your-256-bit-secret-key-here-generate-with-openssl-rand-base64-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# JWT JTI Storage Configuration
JTI_REDIS_URL=redis://localhost:6379/0
JTI_STORAGE_TTL=2592000  # 30 days in seconds

# Session Configuration
SESSION_SECRET_KEY=your-session-secret-key-here
SESSION_EXPIRE_SECONDS=1800  # 30 minutes

# Rate Limiting
RATE_LIMIT=100
RATE_WINDOW=60  # seconds

# =====================================================
# SSL/TLS CONFIGURATION
# =====================================================
SSL_CERT_PATH=/etc/ssl/certs/cultivar.crt
SSL_KEY_PATH=/etc/ssl/private/cultivar.key
SSL_VERIFY_MODE=required
FORCE_HTTPS=true

# Let's Encrypt (automatic SSL)
LETSENCRYPT_EMAIL=admin@cultivar-app.com
LETSENCRYPT_DOMAIN=cultivar-app.com

# =====================================================
# EXTERNAL SERVICES
# =====================================================

# Redis Configuration (for sessions, caching, rate limiting)
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=your_redis_password

# Hypergraph Service (GraphQL)
HYPERGRAPH_URL=http://hypergraph-service:8001/graphql

# File Storage
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=cultivar-files
AWS_REGION=us-east-1

# Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=noreply@cultivar-app.com
SMTP_PASSWORD=your_smtp_password
SMTP_USE_TLS=true

# =====================================================
# MONITORING & LOGGING
# =====================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
ENABLE_AUDIT_LOG=true
AUDIT_LOG_RETENTION_DAYS=90

# Sentry (error monitoring)
SENTRY_DSN=https://your-sentry-dsn-here

# =====================================================
# API CONFIGURATION
# =====================================================
API_VERSION=v2
API_PREFIX=/api/v2
API_DOCS_ENABLED=false  # Disable in production
API_REDOC_ENABLED=false

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://cultivar-app.com,https://www.cultivar-app.com,https://admin.cultivar-app.com
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Requested-With,Accept,Origin

# =====================================================
# MOBILE APP CONFIGURATION
# =====================================================
MOBILE_API_BASE_URL=https://api.cultivar-app.com
MOBILE_VERSION_CHECK_ENABLED=true
MOBILE_FORCE_UPDATE=false

# =====================================================
# WEBHOOKS & INTEGRATIONS
# =====================================================
WEBHOOK_SECRET=your-webhook-secret-key
SENSOR_WEBHOOK_URL=https://api.cultivar-app.com/webhooks/sensors
ADMIN_WEBHOOK_URL=https://api.cultivar-app.com/webhooks/admin

# =====================================================
# SECURITY HEADERS
# =====================================================
ENABLE_CSP=true
CSP_POLICY=default-src 'self'; script-src 'self' 'nonce-{nonce}'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
ENABLE_HSTS=true
HSTS_MAX_AGE=31536000
ENABLE_XFRAME_OPTIONS=true
ENABLE_XCONTENT_TYPE_OPTIONS=true
ENABLE_REFERRER_POLICY=true

# =====================================================
# DEVELOPMENT ONLY (DO NOT USE IN PRODUCTION)
# =====================================================
# ALLOW_INSECURE_CONNECTIONS=true
# DISABLE_RATE_LIMITING=true
# DISABLE_AUTH_REQUIRED=true